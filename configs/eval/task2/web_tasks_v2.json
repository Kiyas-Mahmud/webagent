{
 "suite": "web-tasks-v2",
 "created": "2026-10-04",
 "derived_from": "web-tasks-v1 (2026-09-28)",
 "purpose": "Live real-website tasks on domains from the author's dataset (web_agent_gold_v16_500_domain_40k, 305 domains). P1 judges pages like its training data.",
 "viewport": {
  "width": 1280,
  "height": 720
 },
 "success_rule": "Completed when the current page equals the target page: lower-cased host without 'www.' plus path without trailing slash, ignoring query string and fragment ('page'); or starts with it ('page_prefix', list pages); or its host is the given site ('site'). Checked by the environment after every step, never shown to the agent.",
 "splits": {
  "development": "the 18 v1 tasks kept + 2 replacements; recovery v3-v3.3 was designed while observing 10 of these",
  "held_out": "20 tasks written and verified on 2026-10-04 before any agent run with them"
 },
 "audit_2026_10_04": {
  "removed": {
   "arxiv-abs-1706-03762": "title-only search never shows 1706.03762 in the top 50 results (first with author name, which the goal lacks); infeasible as written",
   "debian-distrib": "goal names a 'Getting Debian' page that does not exist; the link reads 'Other downloads' and the prominent Download button is an ISO file"
  },
  "rule_change": "v1 used URL substring matching: it accepted wiki/ephemeral_lake for 'ephemeral' (2 false completions for system C in web-v2), 101 single-talk pages for ted.com/talks, and sub-pages of yale/admissions, ietf/process/rfcs, admission.stanford.edu",
  "metadata_fix": {
   "creativecommons-cc-licenses": "target now /cc-licenses/ (old URL redirects there)"
  },
  "held_out_rejected": {
   "w3c-standards": "Cloudflare challenge (403)",
   "loc-collections": "Cloudflare challenge (403) on target",
   "creativecommons-about": "/about redirects to /what-we-do",
   "harvard-admissions": "/admissions redirects to /programs"
  }
 },
